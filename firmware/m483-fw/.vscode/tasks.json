{
	"version": "2.0.0",
  "tasks": [
    {
      "label": "build-configure",
      "type": "shell",
      "osx":{
        "command": "cmake -S . -B build -DKEYBOARD_PATH='/keyboards/baram/${input:board}'",
      },
      "windows":{
        "command": "cmake -S . -B build -G 'MinGW Makefiles' -DKEYBOARD_PATH='/keyboards/baram/${input:board}'",
      },
      "problemMatcher": []
    },
    {
      "label": "build-build",
      "type": "shell",
      "osx":{
        "command": "cmake -S . -B build -DKEYBOARD_PATH='/keyboards/baram/${input:board}' && cmake --build build -j10",
      },
      "windows":{
        "command": "cmake -S . -B build -G 'MinGW Makefiles' -DKEYBOARD_PATH='/keyboards/baram/${input:board}'; cmake --build build -j10",
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": [],
    },

    {
      "label": "deploy-image",
      "detail": "전체 보드 clean 빌드 + 릴리즈 zip 생성 (output/WISH-V<날짜>R<n>.zip)",
      "type": "shell",
      "osx":{
        "command": "python3 tools/build_wish.py -c",
      },
      "windows":{
        "command": "python tools/build_wish.py -c",
      },
      "problemMatcher": [],
    }

  ],

  "inputs": [
    {
      "id": "board",
      "type": "pickString",
      "description": "빌드할 보드를 선택하세요",
      "options": [
        { "value": "45k", "label": "WISH45-8K (baram/45k)" }
      ],
      "default": "45k"
    }
  ]
}

{
	"version": "2.0.0",
  "tasks": [
    {
      "label": "build-configure",
      "type": "shell",
      "osx":{
        "command": "cmake -S . -B build",
      },
      "windows":{
        "command": "cmake -S . -B build -G 'MinGW Makefiles'",
      },
      "problemMatcher": []
    },    
    {
      "label": "build-build",
      "type": "shell",
      "command": "cmake --build build -j10",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": [],
    },

    {
      "label": "uf2-make-uf2",
      "type": "shell",
      "command": "tools/uf2/uf2conv.py build/m483-boot.bin --family 0xFFFF0002 --base 0x00000000 --convert --output build/m483-boot.uf2",
      "problemMatcher": [],
    }

  ]
}